# Phase 6 — copy this to .env (gitignored, see .gitignore) and fill in real values for local
# `docker compose up`. On the OCI VM, this file is placed out-of-band via scp, root-owned,
# chmod 600 — never committed, never baked into an image (see CLAUDE.md's Phase 6 plan §2c/§4).

# --- PostgreSQL ---
POSTGRES_DB=stockpredictor
POSTGRES_USER=stockpredictor_app
POSTGRES_PASSWORD=

# --- Backend (Spring Boot) ---
DB_URL=jdbc:postgresql://postgres:5432/stockpredictor
DB_USERNAME=stockpredictor_app
DB_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
PREDICTION_SERVICE_URL=http://ai-service:8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
COINGECKO_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# --- nginx ---
# The reserved-IP-derived sslip.io hostname on the real OCI VM (see CLAUDE.md's Phase 6 plan
# §2b) — "localhost" is correct for local dev, matching docker/generate-local-certs.sh's cert.
SERVER_NAME=localhost
