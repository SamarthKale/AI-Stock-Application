<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override of app/src/main/res/xml/network_security_config.xml. Same filename, so
  Gradle prefers this one for the debug build variant; Release never sees this file at all and
  keeps the main one unchanged. Adds 127.0.0.1 alongside 10.0.2.2 so a physical device reached
  via `adb reverse tcp:8080 tcp:8080` (see net/BackendUrlResolver.kt) can also make cleartext
  HTTP requests to the local backend. Still not a blanket android:usesCleartextTraffic="true",
  only these two loopback-style dev addresses, and only in Debug.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
