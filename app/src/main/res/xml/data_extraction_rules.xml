<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer rules (Android 12+).
  Reown (WalletConnect) keeps its wallet-session state in an encrypted database whose key lives in
  the device's hardware-backed Keystore. A restored copy on another device could never be decrypted,
  so it is excluded from both cloud backup and device-to-device transfer. These rules replace
  Reown's own identical file (see tools:replace in AndroidManifest.xml) so the app keeps one
  authoritative set of rules.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="WalletConnectV2.db"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="WalletConnectV2.db"/>
    </device-transfer>
</data-extraction-rules>
