<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 6-11 (Android 12+ uses data_extraction_rules.xml).
  The WalletConnect/Reown session database is encrypted with a Keystore-bound key, so a restored
  copy would be unreadable on another device: never back it up.
-->
<full-backup-content>
    <exclude domain="database" path="WalletConnectV2.db"/>
</full-backup-content>
