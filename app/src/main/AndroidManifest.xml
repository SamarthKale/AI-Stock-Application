<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required from Phase 2.5 onward: Firebase Auth/Firestore/FCM all need network access. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime-requested (Android 13+) right after first successful login, not on cold start. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Practical 7 GPS: one-shot foreground fix for Exchange Map's "Locate me" action, requested
         at runtime only when the user taps the button (see ExchangeMapScreen). Deliberately no
         ACCESS_BACKGROUND_LOCATION: this feature never tracks continuously or in the background. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Phase 5c: alert-notification deep links (stockpredictor://crypto_detail/{coinId}),
                 built by StockPredictorFcmService as a plain ACTION_VIEW Intent. singleTask above
                 ensures a tap while the app is already running calls onNewIntent rather than
                 stacking a duplicate MainActivity instance. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="stockpredictor" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.StockPredictorFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>