*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Firebase config — contains project-specific API keys; repo is public, never commit this.
/app/google-services.json

# Phase 6 — release signing. Losing this keystore means losing the ability to publish updates
# under the same app listing; back it up somewhere outside the repo (a secrets manager or an
# encrypted archive), never here.
/release.keystore.jks
/keystore.properties

# Phase 6 — backend/ai-service local secrets, mirrors local.properties' gitignore pattern.
/.env
/backend/.env
/ai-service/.env
*.env
!*.env.example

# Phase 6 — OCI/GCP credentials that might be dropped locally for scripts (never committed).
firebase-service-account.json
oci-config/
*.pem
*.key
docker/nginx/certs/

# Phase 6 — Terraform local state/vars (state can contain resource details best kept out of git
# for a public repo; tfvars holds tenancy-identifying OCIDs).
infra/.terraform/
infra/terraform.tfstate
infra/terraform.tfstate.backup
infra/terraform.tfvars
infra/*.tfplan

# Backend (Phase 3) — Gradle build output; the root /build rule above only matches the app module.
backend/build
backend/bin

# AI service (Phase 5/6) — raw training data is large/regenerable (re-run
# ai-service/training/fetch_training_data.py to reproduce), not source. Trained model artifacts
# (ai-service/artifacts/) are the opposite: small (~1.5MB total) and NOT regenerable on demand
# without a full retrain, so they're committed directly (Phase 6 CI/CD fix — the OCI Object
# Storage publish/fetch step they used to require was removed when OCI became blocked on payment
# verification; see CLAUDE.md's Phase 6 STATUS block). Local Python cache and the dev-server log
# are pure local-run byproducts.
ai-service/data/
ai-service/uvicorn.log
ai-service/__pycache__/
ai-service/**/__pycache__/
ai-service/.venv/
